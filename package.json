{
  "name": "fatima-quizbee-engine",
  "version": "1.0.0",
  "description": "OLFU IT Olympics Offline LAN Quiz Bee Management System (ITPM 311)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/e2e/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "csv-parse": "^5.6.0",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
